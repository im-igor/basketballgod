# ─────────────────────────────────────────────────────────────
# basketballgod — пример переменных окружения.
# Скопируй в .env и заполни. НЕ коммить .env в репозиторий.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Telegram ────────────────────────────────────────────────
# Токен бота от @BotFather. (Старый утёкший токен ОБЯЗАТЕЛЬНО отозвать!)
TELEGRAM_BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Режим получения апдейтов: long polling (false) или webhook (true).
TELEGRAM_USE_WEBHOOK=false
# Нужны только при TELEGRAM_USE_WEBHOOK=true:
WEBHOOK_DOMAIN=https://your-app.example.com
WEBHOOK_SECRET=change-me-long-random-string

# ID чатов команд и их топиков "Голосовалки и сборы"
BLACK_CHAT_ID=-1001534260260
BLACK_THREAD_ID=14793
RED_CHAT_ID=-1002058536165
RED_THREAD_ID=3178

# Telegram user_id админов (через запятую) — кому разрешены команды бота.
ADMIN_TG_IDS=524515690

# Варианты ответа в опросе (через запятую)
POLL_OPTIONS=Да,Нет,Для Родиона
# На сколько дней вперёд смотреть события для опросов (фолбэк, если поле в cron_config пустое)
POLL_TRAINING_HORIZON_DAYS=7
POLL_GAME_HORIZON_DAYS=7

# ── Расписание (cron, в таймзоне TZ) ────────────────────────
# Приоритет — БД (cron_config) / вкладка `cron` в Google-таблице (timezone,
# poll_training_weekday, poll_training_time, poll_training_horizon_days,
# poll_game_weekday, poll_game_time, poll_game_horizon_days,
# fixation_day, fixation_time, budget_day, budget_time). Значения ниже — фолбэк,
# если поля нет или значение некорректно. Правки подхватываются автоматически
# (перечитка раз в час), рестарт не нужен.
TZ=Europe/Moscow
# Пятница 12:00 — рассылка опросов (отдельно на тренировки и на игры)
POLL_TRAINING_CRON=0 12 * * 5
POLL_GAME_CRON=0 12 * * 5
# 25-е число 20:00 — уведомление в чаты команд о фиксации участников (за сутки до сбора)
MONTHLY_FIXATION_CRON=0 20 25 * *
# 26-е число 20:00 — черновик бюджета админам в личку
MONTHLY_CRON=0 20 26 * *

# ── Google ──────────────────────────────────────────────────
# ID календарей (Red и Black)
GOOGLE_CALENDAR_RED=e386dbac1cc1494ffcc6f71f0ad324a5da81909e7ec608950bc6cbf938668b8d@group.calendar.google.com
GOOGLE_CALENDAR_BLACK=094c7db6bf91b8619e9c14d7e29893d51365ad5a58004150202d569eccba226e@group.calendar.google.com
# Сервисный аккаунт Google. Один из двух способов:
#  1) путь к JSON-файлу ключа:
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/service-account.json
#  2) ИЛИ весь JSON ключа в base64 (удобно для Yandex Lockbox):
GOOGLE_SERVICE_ACCOUNT_BASE64=
# Google Sheet — витрина: бот только ВЫГРУЖАЕТ в неё данные из БД (кнопка в админке / команда /sheet).
# Обратно не читается. Людям шарим с правами «Читатель», сервис-аккаунту нужен «Редактор».
# Можно не задавать — тогда выгрузка просто вернёт ошибку, на работу бота это не влияет.
GOOGLE_SHEET_ID=1Sa66Jj5XHmkcp-msUvF4SKVhi057QT5NwFs_HncCBHo

# ── База данных ─────────────────────────────────────────────
DATABASE_URL=postgres://basketballgod:basketballgod@db:5432/basketballgod

# ── Админ-панель (веб) ──────────────────────────────────────
HTTP_PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Секрет для подписи cookie-сессии (длинная случайная строка)
SESSION_SECRET=change-me-long-random-string

# Корень резервных копий на ВМ. Если не задан, Compose использует
# $HOME/basketballgod-backups. Создай папку заранее с правами пользователя
# контейнера (UID 1000); путь внутри неё можно менять через админку.
# BACKUP_HOST_ROOT=/home/yc-user/basketballgod-backups

# ── Тарифы ──────────────────────────────────────────────────
# Тарифы берутся из вкладки `tariffs` Google-таблицы (gym_paid_price, locker_rent_price,
# coach_per_session, coach_per_game, referee_default) и синкаются в БД перед каждым расчётом.
# COACH_PER_GAME в коде не используется — можно удалить.

# ── Реквизиты для сбора (ссылки в сообщении бюджета) ────────
PAYMENT_SBER_URL=https://messenger.online.sberbank.ru/sl/e32SAQ4LqXKTuGScL
PAYMENT_TBANK_URL=https://www.tbank.ru/cf/4293unKi0tl
